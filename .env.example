# Repo-root .env — read ONLY by scripts/deploy.py. Copy to .env (gitignored).
#
# The apps have their own env files and neither reads this one:
#   server/.env                  → the Bun API   (see server/.env.example)
#   web/.env.production.local    → the Next site (see web/.env.example)
#
# Real environment variables win over this file, so a one-off deploy to
# another box needs no edit here:
#   SSH_HOST=staging.example.com bun run deploy

# --- Target -------------------------------------------------------------
SSH_HOST=
SSH_USER=root

# Absolute path to the deploy directory on the box (from DEPLOY.md step 2).
DEPLOY_PATH=/srv/voteaxis

# --- Authentication -----------------------------------------------------
# Preferred: SSH keys, nothing secret in this file.
#   ssh-copy-id root@<host>       once, then leave both of these unset.
#
# SSH_KEY — only when the right key is not the one ssh picks by default.
# SSH_KEY=~/.ssh/id_ed25519_voteaxis
#
# SSH_PASSWORD — fallback for a box with no key installed. Requires sshpass
# (brew install hudochenkov/sshpass/sshpass). The deploy authenticates once
# and multiplexes every later step over that connection either way.
# SSH_PASSWORD=

# --- Post-deploy checks -------------------------------------------------
# Public origins, checked through Caddy after the restart. No trailing slash.
WEB_ORIGIN=https://voteaxis.org
API_ORIGIN=https://api.voteaxis.org

# Every deploy probes the site's SMTP relay on the box. Set this to also send
# a real test message there each time; leave it unset to just probe.
# MAIL_CHECK_TO=you@example.com

# --- Backups ------------------------------------------------------------
# Every deploy copies the deploy dir to <DEPLOY_PATH>.backup_<timestamp>
# (state included, node_modules/.next/caches excluded) and prunes copies
# older than this. Restore the newest with: bun run deploy -- --rollback
BACKUP_RETENTION_DAYS=7
