# Copy to .env on the VPS. PM2 loads this file via ecosystem.config.cjs.
PORT=8787

# Loopback only — Caddy/nginx terminates TLS and proxies to 127.0.0.1:8787.
# Binding 0.0.0.0 on a VPS publishes the API on :8787 with no TLS and no
# trustworthy client IP for rate limiting. Use 0.0.0.0 only for LAN dev
# against a physical device; 127.0.0.1 is the code default when HOST is unset,
# so that opt-in has to be deliberate.
HOST=127.0.0.1

DATA_DIR=./data
CODE_TTL_HOURS=48

# Compact receipts index built by scripts/sync_bicam.py
# pip install -r scripts/requirements-bicam.txt
# python3 scripts/sync_bicam.py
BICAM_DB=./data/bicam-receipts.sqlite
BICAM_MIN_CONGRESS=117

# Optional. Free key from https://api.congress.gov/sign-up/
# Hydrates latestAction + official summary on the 10 visible receipt cards.
# Leave unset for BICAM-only receipts (local/dev default).
CONGRESS_API_KEY=
CONGRESS_CACHE=./data/congress-gov-cache.sqlite

# Required to unlock GET /v1/politicians and /v1/politicians/:id at all.
# Unset means locked to everyone — including you — not open to everyone;
# this is the opposite of CONGRESS_API_KEY above. Generate one with:
#   openssl rand -hex 32
# Callers send it back as the x-voteaxis-key header. The Flutter app reads
# its copy from --dart-define=VOTEAXIS_POLITICIANS_KEY=<same value>.
POLITICIANS_API_KEY=

# Second, independent way to unlock /v1/politicians — meant for a general
# release, where POLITICIANS_API_KEY above stops being useful (a value baked
# into a shipped binary is not actually secret). When true, a request signed
# by a per-install keypair registered via POST /v1/device-tokens also
# authorizes the roster — the private key never leaves the device, so there
# is nothing static to extract. When false (the default), devices still
# register fine but a signature does not open anything — there is no account
# to gate registration on, so this flag is what keeps that route from being
# an open roster proxy while you are not ready for one. Leave false while
# POLITICIANS_API_KEY above is your only intended caller. See the "Locking
# down /v1/politicians" section of server/README.md for exactly what this
# does and does not prove about the caller.
POLITICIANS_ALLOW_DEVICE_TOKENS=false

# --- Shell-only vars: setting these HERE has no effect ------------------
# Everything above is read by the API process (Bun auto-loads .env in dev;
# PM2 injects it via ecosystem.config.cjs `env` in prod). The two below are
# read outside that process, so they must come from the launching shell.
#
# BICAM_DATA — extract dir for the raw BICAM zips, read by
#   scripts/sync_bicam.py, which does not load this file. `bun run api:sync`
#   already defaults it to server/data/bicam-cache. Override per-run:
#     BICAM_DATA=/mnt/big/bicam bun run api:sync
#   Default when unset and run directly: ~/.bicam
#
# BUN_BIN — absolute path to the bun binary used as the PM2 interpreter.
#   ecosystem.config.cjs reads it while PM2 *evaluates* the config, before
#   this file is loaded, so it must be exported at launch:
#     BUN_BIN=/root/.bun/bin/bun pm2 start ecosystem.config.cjs
#   Falls back to `command -v bun`, then bare `bun`. Set it when PM2 runs
#   under a service manager whose PATH lacks bun.
