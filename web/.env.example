# Dev:  copy to .env.local
# VPS:  copy to .env.production.local  (PM2 reads it via ecosystem.config.cjs)
#
# NEXT_PUBLIC_* vars are inlined into the client bundle by `next build`, so
# this file must be in place BEFORE you build — changing it afterwards has no
# effect until the next build. Everything else is read at runtime.

# --- Site ---------------------------------------------------------------
# Canonical/OG URLs and the Stripe success/cancel origin. No trailing slash.
# Code default when unset: https://voteaxis.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Voteaxis API -------------------------------------------------------
# Where /result/<id> reads shared results from. Different host than the site.
# Inlined at build time, and also read by the browser to unlock a password-
# protected result, so it must be reachable from the visitor's machine.
# Code default when unset: https://api.voteaxis.org
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787

# --- Search console verification ----------------------------------------
# Only the token, not the whole <meta> tag. Leave unset until the property is
# claimed — Next omits the tag entirely rather than emitting an empty one.
# Read at build time like every other value here.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# --- Mail (self-hosted SMTP) --------------------------------------------
# The VPS runs Postfix on loopback with OpenDKIM, so the site hands mail to
# 127.0.0.1:25 and Postfix signs and delivers it. No API key, no provider.
#
# SMTP_HOST is the switch: unset means this deployment sends no mail at all
# (the dev default — nothing tries to reach a relay that isn't there).
# SMTP_HOST=localhost
# SMTP_PORT=25
#
# Auth is only for an external relay; loopback Postfix wants none.
# SMTP_USER=
# SMTP_PASS=
#
# The From domain must be one OpenDKIM signs — see the Mail section of
# DEPLOY.md before changing it. Default: Voteaxis <no-reply@voteaxis.org>
# MAIL_FROM=Voteaxis <no-reply@voteaxis.org>
#
# Where waitlist and support notifications land. Default when unset:
# hello@greighstudios.com
# MAIL_NOTIFY_TO=hello@greighstudios.com

# --- Waitlist -----------------------------------------------------------
# JSONL sink path. Default: <web>/data/waitlist.jsonl — keep the default
# unless you have a reason not to: scripts/deploy.py never deletes web/data/
# and captures it in every pre-deploy backup, neither of which is true of a
# path outside the deploy directory.
# WAITLIST_STORE_PATH=./data/waitlist.jsonl

# Per-signup notification address, if it differs from MAIL_NOTIFY_TO.
# WAITLIST_NOTIFY_TO=hello@greighstudios.com

# Optional alternate sink (Zapier / Make / n8n). Independent of SMTP.
# WAITLIST_WEBHOOK_URL=https://hooks.example.com/waitlist

# --- Contribute checkout (Stripe) ---------------------------------------
# Leave unset to show /contribute without live payments (checkout returns 503).
#
# Register the webhook endpoint at https://<site>/api/contribute/webhook —
# NOT /api/support/webhook. The page was renamed and the redirects in
# next.config.mjs cover only the page routes, so the old path 404s.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Set by PM2, not here -----------------------------------------------
# PORT — the HTTP server boots before env files are read, so `next start`
#   takes it only from the real environment. ecosystem.config.cjs sets 3020
#   and passes -H 127.0.0.1 so only the reverse proxy can reach it.
