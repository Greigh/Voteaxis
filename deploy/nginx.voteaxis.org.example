# Voteaxis reverse proxy — this is what is deployed on the VPS.
# Copy to /etc/nginx/sites-available/voteaxis.org, symlink into sites-enabled,
# then: nginx -t && systemctl reload nginx
#
# Certificates come from certbot (the box already uses it for its other sites):
#   certbot certonly --nginx -d voteaxis.org -d www.voteaxis.org -d api.voteaxis.org
#
# Both upstreams bind 127.0.0.1, so this file is the only public entrance.
# Ports: the site is on 3020 rather than Next's default 3000 because this VPS
# is shared and 3000/3001/3010 belong to other apps.

# --- Marketing site: apex ------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name voteaxis.org;

    ssl_certificate /etc/letsencrypt/live/voteaxis.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voteaxis.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Rewrites $remote_addr from the Cloudflare edge IP to the real client.
    # Generated by: see the "Cloudflare real IP" block in DEPLOY.md.
    include /etc/nginx/snippets/cloudflare-real-ip.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;

    # Content-Security-Policy, report-only to start.
    #
    # /result/<id> renders data a stranger authored, so CSP is the layer that
    # keeps a future escaping mistake from becoming account-level. It ships
    # report-only because Next injects inline bootstrap and hydration scripts:
    # watch the browser console through a full pass of the site — home,
    # methodology, contribute, a shared result, the waitlist form — and only
    # then rename this to Content-Security-Policy.
    #
    # 'unsafe-inline' in script-src is what a nonce would replace. Doing that
    # properly means threading a per-request nonce through the Next config, so
    # it is deliberately left as a second step rather than a broken first one.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' https://js.stripe.com; frame-src https://js.stripe.com; connect-src 'self' https://api.voteaxis.org" always;

    # Signups and checkout carry a few hundred bytes. This is nginx's own
    # default made explicit, so nobody has to remember what it is.
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Next.js streams responses; buffering delivers them all at once.
        proxy_buffering off;
    }

    # Stripe verifies the webhook signature against the exact bytes, so
    # nothing may buffer or rewrite this body.
    # The path is /api/contribute/webhook — the page and its routes were
    # renamed from /support, and the redirects in web/next.config.mjs cover
    # only the two page routes, not this one. A stale /api/support/webhook
    # here (and in the Stripe dashboard) 404s every delivery.
    location /api/contribute/webhook {
        proxy_pass http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
    }
}

# --- Marketing site: www → apex -----------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.voteaxis.org;

    ssl_certificate /etc/letsencrypt/live/voteaxis.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voteaxis.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://voteaxis.org$request_uri;
}

# --- API -----------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.voteaxis.org;

    ssl_certificate /etc/letsencrypt/live/voteaxis.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/voteaxis.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # The API rate-limits on X-Real-IP. Without the snippet above, that header
    # would carry a Cloudflare edge IP and every caller would share a bucket.
    include /etc/nginx/snippets/cloudflare-real-ip.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # A JSON-only API renders nothing and frames nothing.
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    # The API also enforces 64 KB itself (MAX_BODY_BYTES in server/src/app.ts).
    # Both, because whichever one you forget is the one that matters.
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- HTTP → HTTPS --------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name voteaxis.org www.voteaxis.org api.voteaxis.org;

    location /.well-known/acme-challenge/ { root /var/www/html; allow all; }
    location / { return 301 https://$host$request_uri; }
}
